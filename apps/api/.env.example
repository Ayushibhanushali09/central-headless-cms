NODE_ENV=development
PORT=4000
ADMIN_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/central_cms
REDIS_URL=redis://127.0.0.1:6379

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=cms-media
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:9000/cms-media

MAX_SCHEMA_BYTES=100000
MAX_CONTENT_BYTES=1000000
MAX_IMAGE_BYTES=5242880
MAX_SCHEMA_DEPTH=12
MAX_CONTENT_DEPTH=20

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m

JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_TTL_DAYS=7

ACCESS_KEY_PEPPER=replace-with-at-least-32-random-characters
ACCESS_KEY_BYTES=32

DELIVERY_CACHE_TTL_SECONDS=3600